# ============================================
# Kolabri AI-Engine Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server Configuration
HOST=0.0.0.0
PORT=8001
ENV=development
DEBUG=true

# OpenAI Compatible API (GPT 5.4 Mini)
OPENAI_API_KEY=sk-ama
OPENAI_BASE_URL=http://43.228.214.145:8317/v1
OPENAI_MODEL=deepseek-v4-flash
OPENAI_EMBEDDING_MODEL=embedding-2
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=16000

# No Google services used (project focuses on OpenAI-compatible only)

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kolabri

# Vector Database (ChromaDB) - Legacy
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=kolabri

# PDF Processing
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35

# Core-API Integration
CORE_API_URL=http://localhost:3000
CORE_API_SECRET=shared-secret-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kolabri
ENABLE_MONGODB_LOGGING=true

# Efficiency Guard Configuration
ENABLE_EFFICIENCY_GUARD=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=1000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# HuggingFace Token (for embedding model downloads)
HF_TOKEN=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

# Persistent reranker cache (avoid macOS /var/folders eviction)
RERANK_CACHE_DIR=/Users/hshino/.cache/kolabri-fastembed

# Redis (override default REDIS_PORT=32768 from config.py)
REDIS_HOST=localhost
REDIS_PORT=6379
