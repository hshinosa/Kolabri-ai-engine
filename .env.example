# ============================================
# Kolabri AI-Engine Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server Configuration
HOST=0.0.0.0
PORT=8001
ENV=development
DEBUG=true

# Unified Provider Configuration (Database-Driven)
# Set to true to fetch provider config from Core API database
# Set to false to use environment variables below (fallback)
UNIFIED_PROVIDER_ENABLED=false

# OpenAI Compatible API (GLM-4.7)
# These are FALLBACK values when UNIFIED_PROVIDER_ENABLED=false
# or when database fetch fails
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://43.228.214.145:8317/v1
OPENAI_MODEL=glm-4.7
OPENAI_EMBEDDING_MODEL=embedding-2
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# No Google services used (project focuses on OpenAI-compatible only)

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=kolabri

# Embedding Provider: "voyage" (primary, remote API) or "local" (backup, FastEmbed).
# Voyage auto-falls back to local when VOYAGE_API_KEY is empty or the API is down.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_MODEL=voyage-3.5
VOYAGE_OUTPUT_DIMENSION=1024
VOYAGE_BATCH_SIZE=128
VOYAGE_MAX_ATTEMPTS=3
VOYAGE_RETRY_BACKOFF=1.0
VOYAGE_TIMEOUT=60

# Local FastEmbed backup (also used by the reranker)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# PDF Processing
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Core-API Integration
CORE_API_URL=http://localhost:3000
CORE_API_SECRET=shared-secret-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kolabri
ENABLE_MONGODB_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Efficiency Guard Configuration
ENABLE_EFFICIENCY_GUARD=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=1000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3

# RAG Re-Ranking Configuration
ENABLE_RERANKING=true
RERANK_MODEL_NAME=jinaai/jina-reranker-v2-base-multilingual
RERANK_TOP_K=3
RERANK_RETRIEVE_K=10
# Custom cache dir for reranker models (recommended on macOS to avoid /var/folders eviction)
# Leave empty to use fastembed default. Local example: /Users/<you>/.cache/kolabri-fastembed
RERANK_CACHE_DIR=
