# Kolabri AI Engine - Production Environment
# Copy to .env.production and update values

# Server
HOST=0.0.0.0
PORT=8001
ENV=production
DEBUG=false

# OpenAI Compatible API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=16000

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kolabri

# Core API Integration
CORE_API_URL=https://kolabri.jmola.my.id/api
CORE_API_SECRET=change-this-to-strong-secret-in-production

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=kolabri
ENABLE_MONGODB_LOGGING=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Efficiency Guard
ENABLE_EFFICIENCY_GUARD=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=1000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# PDF Processing
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# HuggingFace Token (for embedding models)
HF_TOKEN=your-huggingface-token-here

# Reranker cache
RERANK_CACHE_DIR=/app/cache/reranker
